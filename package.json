{
  "name": "swiftmesh",
  "version": "0.2.8",
  "private": true,
  "description": "SwiftMesh \u2014 open local .glb / .gltf / .obj, inspect, record turntable",
  "author": "Somer Tang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/somertang/swiftmesh.git"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-gltf-vendor.mjs && vite",
    "build": "node scripts/sync-gltf-vendor.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "sync:vendor": "node scripts/sync-gltf-vendor.mjs",
    "brand-icons": "node scripts/generate-brand-icons.mjs",
    "prepare-ffmpeg-mac": "node scripts/prepare-ffmpeg-mac.mjs",
    "dist:win": "pnpm run build && pnpm run brand-icons && electron-builder --win --publish never",
    "dist:win:publish": "pnpm run build && pnpm run brand-icons && electron-builder --win nsis --publish always",
    "dist:mac": "pnpm run build && pnpm run brand-icons && pnpm run prepare-ffmpeg-mac && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "preview": "vite preview"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "ffmpeg-static"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify/react": "^6.0.2",
    "@mui/material": "^9.2.0",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.5",
    "@react-three/fiber": "^9.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.170.0",
    "typescript": "^5.5.0",
    "vite": "^6.2.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.swiftmesh.app",
    "productName": "SwiftMesh",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "somertang",
        "repo": "swiftmesh",
        "private": false,
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "glb",
        "name": "SwiftMesh.GLB",
        "description": "glTF Binary 3D Model",
        "mimeType": "model/gltf-binary",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "gltf",
        "name": "SwiftMesh.GLTF",
        "description": "glTF 3D Model",
        "mimeType": "model/gltf+json",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "obj",
        "name": "SwiftMesh.OBJ",
        "description": "Wavefront OBJ 3D Model",
        "mimeType": "model/obj",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "ffmpeg/ffmpeg.exe"
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "build/ffmpeg/darwin-${arch}/ffmpeg",
          "to": "ffmpeg/ffmpeg"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "allowElevation": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
